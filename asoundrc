# Your physical card and loopback (adjust hw:0,0 to yours)
pcm.multi {
    type multi
    slaves {
        a { pcm "hw:1,0" channels 2 }
        b { pcm "hw:Loopback,1" channels 2 }
    }
    bindings {
        0 { slave a channel 0 }
        1 { slave a channel 1 }
        2 { slave b channel 0 }
        3 { slave b channel 1 }
    }
}

# Route the 4-channel multi back to 2 channels
pcm.duplex {
    type route
    slave.pcm "multi"
    ttable {
        0.0 1
        1.1 1
        0.2 1
        1.3 1
    }
}

# Add a software volume control
pcm.softvolume {
    type softvol
    slave.pcm "duplex"
    control {
        name "Master"
        card 0            # card number where the virtual control will appear
    }
}

# Make this the default
pcm.!default {
    type plug
    slave.pcm "softvolume"
}
